PORT=8787
HOST=0.0.0.0
NODE_ENV=production
COOKIE_SECURE=true

# MongoDB Atlas connection string: Atlas → Database → Connect → Drivers.
# It contains the database user's password, so enter it only on the server.
# Example shape: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
# Database name inside the cluster (created automatically).
MONGODB_DB=relaydesk

# Set one first administrator account before deployment. Use a unique password of 16+ characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Create a long random value and enter the same value in Meta's webhook settings.
WA_VERIFY_TOKEN=

# Meta app secret used to validate X-Hub-Signature-256 on POST webhook requests.
META_APP_SECRET=

# Needed for Cloud API send and number sync.
# Do not put real values in this example file or send them in chat.
WA_BUSINESS_ACCOUNT_ID=
WA_ACCESS_TOKEN=
WA_GRAPH_API_VERSION=

# Set to true when a reverse proxy or tunnel (Nginx, Caddy, Cloudflare Tunnel)
# sits in front of the app, so login throttling uses the visitor's IP.
TRUST_PROXY=true

# Backups (npm run backup). Keep BACKUP_DIR OUTSIDE the app folder so a redeploy
# does not delete it. Defaults to ~/relaydesk-backups and keeps 14 files.
BACKUP_DIR=
BACKUP_KEEP=14

# Optional: delete messages older than this many days (npm run maintenance).
# Leave empty to keep messages indefinitely.
MESSAGE_RETENTION_DAYS=
