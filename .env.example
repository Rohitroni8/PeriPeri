PORT=8787
HOST=0.0.0.0
NODE_ENV=production
COOKIE_SECURE=true

# Hostinger MySQL. Use 127.0.0.1 on managed hosting, not localhost.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Set one first administrator account before deployment. Use a unique password of 16+ characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Create a long random value and enter the same value in Meta's webhook settings.
WA_VERIFY_TOKEN=

# Meta app secret used to validate X-Hub-Signature-256 on POST webhook requests.
META_APP_SECRET=

# Needed for Cloud API send and number sync.
# Do not put real values in this example file or send them in chat.
WA_BUSINESS_ACCOUNT_ID=
WA_ACCESS_TOKEN=
WA_GRAPH_API_VERSION=
